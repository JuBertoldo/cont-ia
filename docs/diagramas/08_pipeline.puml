@startuml 08_pipeline
!pragma layout smetana
title Cont.IA — Pipeline de Detecção (YOLO11 + MobileSAM)

skinparam backgroundColor #FFFFFF
skinparam activityBackgroundColor #F0FFF4
skinparam activityBorderColor #00E676
skinparam activityFontColor #1A1A1A
skinparam arrowColor #00E676
skinparam titleFontColor #1A1A1A
skinparam titleFontSize 16
skinparam partitionBackgroundColor #FAFAFA
skinparam partitionBorderColor #333333
skinparam partitionFontColor #333333
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F59E0B
skinparam noteFontColor #E65100

start

:Receber imagem como Base64;

partition "Passo 1 — YOLO11 (detecção)" {
    :Decodificar Base64 → PIL Image (RGB);

    note right
      Realce automático se brilho médio < 100:
      Brightness x1.5 + Contrast x1.3
      (melhora detecção em galpões escuros)
    end note

    :Converter para numpy array (image_rgb)\n→ compartilhado com MobileSAM;

    :Inferência YOLO11m\n(yolo11m.pt — CPU local);

    :Extrair para cada detecção:\n• label (classe do objeto)\n• confidence (0.0 – 1.0)\n• bbox [x1, y1, x2, y2] em pixels;

    note right
      Modelo: yolo11m.pt
      80 classes COCO (traduzidas PT-BR)
      Threshold: YOLO_CONF (padrão 0.25)
    end note
}

if (Alguma detecção encontrada?) then (Sim)

    partition "Passo 2 — SAM via ultralytics (segmentação)" {
        :Passar image_rgb + lista de bbox\ncomo box prompts para o SAM;

        note right
          ultralytics.SAM — mesmo pacote do YOLO11
          100% local — sem API externa
          Checkpoint: /app/mobile_sam.pt (38 MB)
          Sem dependência extra no requirements.txt
        end note

        :model.predict(\n  source=image_rgb,\n  bboxes=boxes,\n  verbose=False\n);

        :Para cada máscara retornada:\n• Polígono via results[0].masks.xy (pronto, sem OpenCV)\n• Calcular área via masks.data.sum()\n• sam_score: 1.0 (ultralytics não expõe IoU diretamente);
    }

    :Combinar YOLO + SAM por índice:\n{label, confidence, bbox,\nmask_polygon, mask_area, source: "yolo+sam"};

else (Não)
    :Retornar lista vazia;
endif

:Registrar métricas Prometheus\n(contia_detections_total, duration);

:Retornar JSON:\n{\n  detections: [\n    {label, confidence, bbox,\n     mask_polygon, mask_area, source}\n  ],\n  meta: {model, processing_ms,\n         pipeline: {yolo_count, sam_count}}\n};

note right
  Degradação graciosa:
  Se SAM falhar → retorna só bbox YOLO
  (mask_polygon: null, mask_area: null)
  O app continua funcionando normalmente.
end note

stop

@enduml
