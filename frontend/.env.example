# ─────────────────────────────────────────────────────────────────────────────
# Cont.IA — Variáveis de ambiente do Frontend (React Native)
#
# Como usar:
#   cp frontend/.env.example frontend/.env
#   Preencha os valores reais no frontend/.env
#   NUNCA commite o .env — ele já está no .gitignore.
#
# Onde encontrar os valores do Firebase:
#   Firebase Console → Configurações do projeto → Seus apps → SDK config
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────

FIREBASE_API_KEY=AIzaSy_SUBSTITUA_PELA_SUA_CHAVE
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:ios:0000000000000000

# ── Backend (FastAPI + YOLO) ──────────────────────────────────────────────────
# Desenvolvimento local (simulador iOS):    http://localhost:8000
# Desenvolvimento local (dispositivo físico na mesma rede Wi-Fi):
#                                           http://SEU_IP_LOCAL:8000
# Cloudflare Tunnel (permanente):           https://sua-url.trycloudflare.com
# Tunnel rápido (ngrok / cloudflared):      https://<tunnel-url>

YOLO_API_URL=http://localhost:8000

# ── Sentry (opcional) ────────────────────────────────────────────────────────
# Deixe vazio para desativar. Configure em produção para capturar erros.
# Obtenha em: https://sentry.io → Settings → Projects → Client Keys (DSN)

SENTRY_DSN=

# ── Firebase Local Emulator ───────────────────────────────────────────────────
# true  → conecta ao emulador local (execute: firebase emulators:start)
# false → conecta ao Firebase real (padrão para produção)

USE_FIREBASE_EMULATOR=false
