# ─────────────────────────────────────────────────────────────────────────────
# Cont.IA — Variáveis de ambiente do Backend (FastAPI)
#
# Como usar:
#   cp backend/.env.example backend/.env
#   Preencha os valores reais no backend/.env
#   NUNCA commite o .env — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development → logs detalhados, docs Swagger em /docs, CORS permissivo
# production  → sem docs, CORS restrito, SENTRY_DSN obrigatório

API_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Baixe em: Firebase Console → Configurações do projeto →
#           Contas de serviço → Gerar nova chave privada
# Salve o arquivo JSON na raiz do backend/ e aponte o caminho abaixo.

FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── Modelo YOLO ───────────────────────────────────────────────────────────────
# yolo11m.pt  → modelo médio (padrão, bom equilíbrio velocidade/precisão)
# yolo11n.pt  → modelo nano (mais rápido, menos preciso)
# contia_v1.pt → modelo próprio treinado com dataset do Cont.IA (quando disponível)

YOLO_MODEL=yolo11m.pt
YOLO_CONF=0.35
YOLO_TIMEOUT_S=55

# ── Ensemble (Roboflow RF-DETR) ───────────────────────────────────────────────
# Deixe ROBOFLOW_API_KEY vazio para desativar o RF-DETR e usar só YOLO.
# Obtenha em: https://app.roboflow.com → Settings → Roboflow API

ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=seu-workspace
ROBOFLOW_WORKFLOW_ID=seu-workflow-id
ENSEMBLE_IOU_THRESHOLD=0.5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Desenvolvimento: * (permite qualquer origem)
# Produção: liste as origens explícitas separadas por vírgula
#   Ex: CORS_ORIGINS=https://app.contia.com,https://admin.contia.com

CORS_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT=30/minute

# ── Sentry (opcional) ────────────────────────────────────────────────────────
# Deixe vazio para desativar. Configure em produção para capturar erros.

SENTRY_DSN=

# ── E-mail (SMTP) — notificações de ticket ────────────────────────────────────
# Gmail: crie uma "Senha de app" em:
#   myaccount.google.com → Segurança → Verificação em duas etapas → Senhas de app
# Deixe SMTP_USER vazio para desativar envio de e-mails.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gmail
EMAIL_FROM_NAME=Cont.IA Suporte
